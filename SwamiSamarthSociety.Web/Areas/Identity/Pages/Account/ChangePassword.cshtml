@page
@model ChangePasswordModel

@{
    ViewData["Title"] = "Change Password";
    Layout = "/Views/Shared/_AuthLayout.cshtml";
}

<div class="auth-shell">
    <div class="auth-brand">
        <div>
            <div class="auth-brand-mark">V</div>
            <div class="auth-brand-title">Vasati24</div>
            <div class="auth-brand-devanagari">सभासद व्यवस्थापन प्रणाली</div>
            @if (Model.Forced)
            {
                <div class="auth-brand-subtitle">For security, please set your own password before continuing.</div>
            }
            else
            {
                <div class="auth-brand-subtitle">Update the password for your account.</div>
            }
        </div>
        <div class="auth-brand-footer">&copy; @DateTime.Now.Year Vasati24</div>
    </div>

    <div class="auth-form-panel">
        <div class="auth-form-header">
            <h1>@(Model.Forced ? "Set your password" : "Change password")</h1>
            <p>Choose a password only you know.</p>
        </div>

        @if (!string.IsNullOrEmpty(Model.StatusMessage))
        {
            <div class="alert alert-success">@Model.StatusMessage</div>
        }

        <div asp-validation-summary="ModelOnly" class="auth-summary" role="alert"></div>

        <form method="post">
            <input type="hidden" name="forced" value="@Model.Forced" />

            <div class="auth-field">
                <input asp-for="Input.OldPassword" id="Input_OldPassword" class="form-control" autocomplete="current-password" placeholder=" " />
                <label asp-for="Input.OldPassword">@(Model.Forced ? "Temporary password" : "Current password")</label>
                <span asp-validation-for="Input.OldPassword" class="text-danger"></span>
            </div>

            <div class="auth-field">
                <input asp-for="Input.NewPassword" id="Input_NewPassword" class="form-control" autocomplete="new-password" placeholder=" " />
                <label asp-for="Input.NewPassword">New password</label>
                <span asp-validation-for="Input.NewPassword" class="text-danger"></span>
            </div>

            <div class="auth-field">
                <input asp-for="Input.ConfirmPassword" id="Input_ConfirmPassword" class="form-control" autocomplete="new-password" placeholder=" " />
                <label asp-for="Input.ConfirmPassword">Confirm new password</label>
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
            </div>

            <button type="submit" class="auth-submit">Save password</button>
        </form>
    </div>
</div>
