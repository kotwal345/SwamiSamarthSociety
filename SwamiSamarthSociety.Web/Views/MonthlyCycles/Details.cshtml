@model MonthlyCycleDetailsViewModel
@{
    ViewData["Title"] = "Collection Sheet";
    var cycle = Model.Cycle;
    bool isOpen = cycle.Status == "Open";
    string[] monthNames = { "", "January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December" };
}

<div class="page-header">
    <div>
        <span class="page-eyebrow">मासिक हप्ता</span>
        <h1>@monthNames[cycle.Month] @cycle.Year</h1>
        <p class="page-subtitle">
            <span class="badge @(isOpen ? "bg-success" : "bg-secondary")">@cycle.Status</span>
            &nbsp;Collection sheet for this cycle.
        </p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">All Cycles</a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success mb-3">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger mb-3">@TempData["Error"]</div>
}

<div class="stat-row">
    <div class="stat-tile accent-primary">
        <div class="stat-value">₹@cycle.ExpectedShareAmount.ToString("N0")</div>
        <div class="stat-label">Expected Share</div>
    </div>
    <div class="stat-tile accent-success">
        <div class="stat-value">₹@cycle.CollectedShareAmount.ToString("N0")</div>
        <div class="stat-label">Collected Share</div>
    </div>
    <div class="stat-tile accent-muted">
        <div class="stat-value">₹@cycle.PendingShareAmount.ToString("N0")</div>
        <div class="stat-label">Pending Share</div>
    </div>
    <div class="stat-tile accent-accent">
        <div class="stat-value">₹@cycle.TotalPrincipalCollected.ToString("N0") + ₹@cycle.TotalInterestCollected.ToString("N0")</div>
        <div class="stat-label">Principal + Interest Collected</div>
    </div>
</div>

<div class="table-panel" style="overflow-x: auto;">
    <table class="table">
        <thead>
            <tr>
                <th>Member</th>
                <th>Share Due</th>
                <th>Share Paid</th>
                <th>Opening Balance</th>
                <th>Principal Due</th>
                <th>Interest Due</th>
                <th>Loan Paid</th>
                <th>Remaining</th>
                @if (isOpen)
                {
                    <th></th>
                }
            </tr>
        </thead>
        <tbody>
            @foreach (var row in Model.Rows)
            {
                <tr>
                    <td>
                        <div class="cell-name">
                            <span class="member-avatar">@row.FullName.Substring(0, 1).ToUpper()</span>
                            <div>
                                <div class="cell-name-text">@row.FullName</div>
                                <div class="cell-name-sub"><code class="member-code">@row.MemberCode</code></div>
                            </div>
                        </div>
                    </td>
                    <td>₹@row.ShareExpected.ToString("N0")</td>

                    @if (isOpen)
                    {
                        <td colspan="7">
                            <form asp-action="Collect" method="post" class="table-inline-form">
                                <input type="hidden" name="cycleId" value="@cycle.MonthlyCycleId" />
                                <input type="hidden" name="memberId" value="@row.MemberId" />
                                <input type="hidden" name="paymentDate" value="@DateTime.Today.ToString("yyyy-MM-dd")" />
                                <input class="form-control form-control-sm" type="number" step="0.01" name="shareAmountPaid" value="@row.SharePaid" title="Share paid" />
                                @if (row.HasActiveLoan)
                                {
                                    <span class="cell-name-sub">Bal ₹@row.OpeningPrincipal?.ToString("N0")</span>
                                    <span class="cell-name-sub">P ₹@row.PrincipalDue?.ToString("N0")</span>
                                    <span class="cell-name-sub">I ₹@row.InterestDue?.ToString("N0")</span>
                                    <input class="form-control form-control-sm" type="number" step="0.01" name="loanAmountPaid" value="@row.LoanPaidAmount" title="Loan installment paid" />
                                    <span class="cell-name-sub">Rem ₹@row.RemainingBalance?.ToString("N0")</span>
                                }
                                else
                                {
                                    <span class="cell-name-sub">No active loan</span>
                                }
                                <button type="submit" class="btn btn-sm btn-primary">Save</button>
                            </form>
                        </td>
                    }
                    else
                    {
                        <td class="row-paid-value">₹@row.SharePaid.ToString("N0")</td>
                        <td>@(row.HasActiveLoan ? $"₹{row.OpeningPrincipal:N0}" : "—")</td>
                        <td>@(row.HasActiveLoan ? $"₹{row.PrincipalDue:N0}" : "—")</td>
                        <td>@(row.HasActiveLoan ? $"₹{row.InterestDue:N0}" : "—")</td>
                        <td class="row-paid-value">@(row.HasActiveLoan ? $"₹{row.LoanPaidAmount:N0}" : "—")</td>
                        <td>@(row.HasActiveLoan ? $"₹{row.RemainingBalance:N0}" : "—")</td>
                    }
                </tr>
            }
        </tbody>
    </table>
</div>

@if (isOpen)
{
    <div class="panel mt-3" style="max-width: 480px;">
        <div class="form-panel-header">
            <h1>Close this cycle</h1>
            <p>Locks the sheet so no further payments can be recorded for @monthNames[cycle.Month] @cycle.Year.</p>
        </div>
        <form asp-action="Close" method="post" class="panel-pad">
            <input type="hidden" name="id" value="@cycle.MonthlyCycleId" />
            <div class="form-field">
                <label class="form-label">Closing Bank Balance</label>
                <input name="closingBankBalance" type="number" step="0.01" class="form-control" value="@cycle.OpeningBankBalance" />
            </div>
            <div class="form-actions">
                <button type="submit" class="btn btn-primary">Close Cycle</button>
            </div>
        </form>
    </div>
}
