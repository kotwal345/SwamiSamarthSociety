@model MonthlyCycleDetailsViewModel
@{
    ViewData["Title"] = "Collection Sheet";
    var cycle = Model.Cycle;
    bool isOpen = cycle.Status == "Open";
    bool canEdit = isOpen && User.IsInRole(AppRoles.Chairman);
    string[] monthNames = { "", "January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December" };

    var totalShareDue = Model.Rows.Sum(r => r.ShareExpected);
    var totalSharePaid = Model.Rows.Sum(r => r.SharePaid);
    var totalOpening = Model.Rows.Sum(r => r.OpeningPrincipal ?? 0m);
    var totalPrincipalDue = Model.Rows.Sum(r => r.PrincipalDue ?? 0m);
    var totalInterestDue = Model.Rows.Sum(r => r.InterestDue ?? 0m);
    var totalLoanPaid = Model.Rows.Sum(r => r.LoanPaidAmount ?? 0m);
    var totalPaid = Model.Rows.Sum(r => r.TotalPaid);
    var totalRemaining = Model.Rows.Sum(r => r.RemainingBalance ?? 0m);
    var totalCollection = cycle.CollectedShareAmount + cycle.TotalPrincipalCollected + cycle.TotalInterestCollected + cycle.OpeningBankBalance;
}

<div class="page-header">
    <div>
        <span class="page-eyebrow">मासिक हप्ता</span>
        <h1>@monthNames[cycle.Month] @cycle.Year</h1>
        <p class="page-subtitle">
            <span class="badge @(isOpen ? "bg-success" : "bg-secondary")">@cycle.Status</span>
            &nbsp;Collection sheet for this cycle.
        </p>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a asp-action="ExportExcel" asp-route-id="@cycle.MonthlyCycleId" class="btn btn-outline-primary">@Icons.Render("download", "icon-sm")Export Excel</a>
        <a asp-action="ExportPdf" asp-route-id="@cycle.MonthlyCycleId" class="btn btn-outline-primary">@Icons.Render("file-text", "icon-sm")Export PDF</a>
        <a asp-action="Index" class="btn btn-outline-secondary">All Cycles</a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success mb-3">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger mb-3">@TempData["Error"]</div>
}

<div class="stat-row">
    <div class="stat-tile accent-primary">
        <span class="stat-icon">@Icons.Render("layers")</span>
        <span class="stat-body">
            <span class="stat-value">₹@cycle.ExpectedShareAmount.ToString("N0")</span>
            <span class="stat-label">Expected Share</span>
        </span>
    </div>
    <div class="stat-tile accent-success">
        <span class="stat-icon">@Icons.Render("check-circle")</span>
        <span class="stat-body">
            <span class="stat-value">₹@cycle.CollectedShareAmount.ToString("N0")</span>
            <span class="stat-label">Collected Share</span>
        </span>
    </div>
    <div class="stat-tile accent-muted">
        <span class="stat-icon">@Icons.Render("clock")</span>
        <span class="stat-body">
            <span class="stat-value">₹@cycle.PendingShareAmount.ToString("N0")</span>
            <span class="stat-label">Pending Share</span>
        </span>
    </div>
    <div class="stat-tile accent-accent">
        <span class="stat-icon">@Icons.Render("percent")</span>
        <span class="stat-body">
            <span class="stat-value">₹@cycle.TotalPrincipalCollected.ToString("N0") + ₹@cycle.TotalInterestCollected.ToString("N0")</span>
            <span class="stat-label">Principal + Interest Collected</span>
        </span>
    </div>
    <div class="stat-tile accent-primary">
        <span class="stat-icon">@Icons.Render("trending-up")</span>
        <span class="stat-body">
            <span class="stat-value">₹@totalCollection.ToString("N0")</span>
            <span class="stat-label">Total Collection (Share + Principal + Interest + Opening Balance)</span>
        </span>
    </div>
    <div class="stat-tile accent-muted">
        <span class="stat-icon">@Icons.Render("credit-card")</span>
        <span class="stat-body">
            <span class="stat-value">₹@((isOpen ? cycle.OpeningBankBalance : cycle.ClosingBankBalance ?? cycle.OpeningBankBalance).ToString("N0"))</span>
            <span class="stat-label">@(isOpen ? "Opening Bank Balance" : "Closing Bank Balance")</span>
        </span>
    </div>
</div>

<div class="table-panel">
    <div class="table-responsive">
    <table class="table">
        <thead>
            <tr>
                <th>Member</th>
                <th>Share Due</th>
                <th>Share Paid</th>
                <th>Opening Balance</th>
                <th>Principal Due</th>
                <th>Interest Due</th>
                <th>Loan Paid</th>
                <th>Total Paid</th>
                <th>Remaining</th>
                @if (canEdit)
                {
                    <th></th>
                }
            </tr>
        </thead>
        <tbody>
            @foreach (var row in Model.Rows)
            {
                var formId = $"collect-{row.MemberId}";
                <tr>
                    <td>
                        @if (canEdit)
                        {
                            <form id="@formId" asp-action="Collect" method="post"></form>
                            <input type="hidden" form="@formId" name="cycleId" value="@cycle.MonthlyCycleId" />
                            <input type="hidden" form="@formId" name="memberId" value="@row.MemberId" />
                            <input type="hidden" form="@formId" name="paymentDate" value="@DateTime.Today.ToString("yyyy-MM-dd")" />
                        }
                        <div class="cell-name">
                            <span class="member-avatar">@row.FullName.Substring(0, 1).ToUpper()</span>
                            <div>
                                <div class="cell-name-text">@row.FullName</div>
                                <div class="cell-name-sub"><code class="member-code">@row.MemberCode</code></div>
                            </div>
                        </div>
                    </td>
                    <td>₹@row.ShareExpected.ToString("N0")</td>

                    @if (canEdit)
                    {
                        <td><input form="@formId" class="form-control form-control-sm" type="number" step="0.01" name="shareAmountPaid" value="@(row.SharePaid > 0 ? row.SharePaid : row.ShareExpected)" title="Share paid" /></td>
                        <td>@(row.HasActiveLoan ? $"₹{row.OpeningPrincipal:N0}" : "—")</td>
                        <td>@(row.HasActiveLoan ? $"₹{row.PrincipalDue:N0}" : "—")</td>
                        <td>@(row.HasActiveLoan ? $"₹{row.InterestDue:N0}" : "—")</td>
                        <td>
                            @if (row.HasActiveLoan)
                            {
                                var loanDefault = row.LoanPaidAmount > 0 ? row.LoanPaidAmount : (row.PrincipalDue ?? 0) + (row.InterestDue ?? 0);
                                <input form="@formId" class="form-control form-control-sm" type="number" step="0.01" name="loanAmountPaid" value="@loanDefault" title="Loan installment paid" />
                            }
                            else
                            {
                                <span class="cell-name-sub">No active loan</span>
                            }
                        </td>
                        <td>₹@row.TotalPaid.ToString("N0")</td>
                        <td>@(row.HasActiveLoan ? $"₹{row.RemainingBalance:N0}" : "—")</td>
                        <td class="text-end"><button type="submit" form="@formId" class="btn btn-sm btn-primary">Save</button></td>
                    }
                    else
                    {
                        <td class="row-paid-value">₹@row.SharePaid.ToString("N0")</td>
                        <td>@(row.HasActiveLoan ? $"₹{row.OpeningPrincipal:N0}" : "—")</td>
                        <td>@(row.HasActiveLoan ? $"₹{row.PrincipalDue:N0}" : "—")</td>
                        <td>@(row.HasActiveLoan ? $"₹{row.InterestDue:N0}" : "—")</td>
                        <td class="row-paid-value">@(row.HasActiveLoan ? $"₹{row.LoanPaidAmount:N0}" : "—")</td>
                        <td class="row-paid-value">₹@row.TotalPaid.ToString("N0")</td>
                        <td>@(row.HasActiveLoan ? $"₹{row.RemainingBalance:N0}" : "—")</td>
                    }
                </tr>
            }
        </tbody>
        <tfoot>
            <tr class="table-total-row">
                <td>Total</td>
                <td>₹@totalShareDue.ToString("N0")</td>
                <td>₹@totalSharePaid.ToString("N0")</td>
                <td>₹@totalOpening.ToString("N0")</td>
                <td>₹@totalPrincipalDue.ToString("N0")</td>
                <td>₹@totalInterestDue.ToString("N0")</td>
                <td>₹@totalLoanPaid.ToString("N0")</td>
                <td>₹@totalPaid.ToString("N0")</td>
                <td>₹@totalRemaining.ToString("N0")</td>
                @if (canEdit)
                {
                    <td></td>
                }
            </tr>
        </tfoot>
    </table>
    </div>
</div>

@if (canEdit)
{
    <div class="panel mt-3" style="max-width: 480px;">
        <div class="form-panel-header">
            <h1>Close this cycle</h1>
            <p>Locks the sheet so no further payments can be recorded for @monthNames[cycle.Month] @cycle.Year.</p>
        </div>
        <form asp-action="Close" method="post" class="panel-pad">
            <input type="hidden" name="id" value="@cycle.MonthlyCycleId" />
            <div class="form-field">
                <label class="form-label">Closing Bank Balance</label>
                <input name="closingBankBalance" type="number" step="0.01" class="form-control" value="@cycle.OpeningBankBalance" />
            </div>
            <div class="form-actions">
                <button type="submit" class="btn btn-primary">Close Cycle</button>
            </div>
        </form>
    </div>
}
