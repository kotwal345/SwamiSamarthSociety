@model List<SwamiSamarthSociety.Data.Entities.MonthlyCycle>
@{
    ViewData["Title"] = "Collection";
    bool hasOpenCycle = ViewBag.HasOpenCycle;
    string[] monthNames = { "", "January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December" };
}

<div class="page-header">
    <div>
        <span class="page-eyebrow">मासिक हप्ता</span>
        <h1>Monthly Collection</h1>
        <p class="page-subtitle">Open a month to start collecting shares and loan installments.</p>
    </div>
    @if (!hasOpenCycle && User.IsInRole(AppRoles.Chairman))
    {
        <a asp-action="OpenNextCycle" class="btn btn-primary">@Icons.Render("plus", "icon-sm")Open Next Cycle</a>
    }
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success mb-3">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger mb-3">@TempData["Error"]</div>
}

@if (Model.Count == 0)
{
    <div class="panel">
        <div class="empty-state">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" /><path d="M16 2v4M8 2v4M3 10h18" /></svg>
            <h3>No cycles yet</h3>
            <p>Open the first monthly cycle to begin collecting shares and installments.</p>
            @if (User.IsInRole(AppRoles.Chairman))
            {
                <a asp-action="OpenNextCycle" class="btn btn-primary mt-2">@Icons.Render("plus", "icon-sm")Open Next Cycle</a>
            }
        </div>
    </div>
}
else
{
    <div class="table-panel">
        <div class="table-responsive">
        <table class="table">
            <thead>
                <tr>
                    <th>Month</th>
                    <th>Status</th>
                    <th>Expected Share</th>
                    <th>Collected Share</th>
                    <th>Pending Share</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Model)
                {
                    <tr>
                        <td>@monthNames[c.Month] @c.Year</td>
                        <td><span class="badge @(c.Status == "Open" ? "bg-success" : "bg-secondary")">@c.Status</span></td>
                        <td>₹@c.ExpectedShareAmount.ToString("N0")</td>
                        <td>₹@c.CollectedShareAmount.ToString("N0")</td>
                        <td>₹@c.PendingShareAmount.ToString("N0")</td>
                        <td class="text-end">
                            <a asp-action="ExportExcel" asp-route-id="@c.MonthlyCycleId" class="btn btn-sm btn-outline-secondary">@Icons.Render("download", "icon-sm")Excel</a>
                            <a asp-action="ExportPdf" asp-route-id="@c.MonthlyCycleId" class="btn btn-sm btn-outline-secondary">@Icons.Render("file-text", "icon-sm")PDF</a>
                            <a asp-action="Details" asp-route-id="@c.MonthlyCycleId" class="btn btn-sm btn-outline-primary">Open @Icons.Render("arrow-right", "icon-sm")</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        </div>
    </div>
}
