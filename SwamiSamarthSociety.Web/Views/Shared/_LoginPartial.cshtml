@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using SwamiSamarthSociety.Data
@using SwamiSamarthSociety.Data.Entities
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@inject ApplicationDbContext Db

<ul class="topbar-user">
@if (SignInManager.IsSignedIn(User))
{
    var initial = (User.Identity?.Name ?? "?").Trim().Substring(0, 1).ToUpper();
    var isSuperAdmin = User.IsInRole(AppRoles.SuperAdmin);
    string? societyName = null;
    if (!isSuperAdmin)
    {
        var societyIdClaim = User.FindFirst("SocietyId")?.Value;
        if (int.TryParse(societyIdClaim, out var societyId))
        {
            societyName = (await Db.Societies.IgnoreQueryFilters().FirstOrDefaultAsync(s => s.SocietyId == societyId))?.Name;
        }
    }
    if (isSuperAdmin)
    {
        <li>
            <a class="btn-nav-ghost" asp-area="SuperAdmin" asp-controller="Societies" asp-action="Index">SuperAdmin</a>
        </li>
    }
    else if (societyName is not null)
    {
        <li><span class="topbar-society-name">@societyName</span></li>
    }
    <li>
        <a class="user-chip" asp-area="Identity" asp-page="/Account/Manage/Index" title="Manage your account">
            <span class="user-chip-avatar">@initial</span>
            <span class="user-chip-name">@User.Identity?.Name</span>
        </a>
    </li>
    <li>
        <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
            <button type="submit" class="btn-nav-logout" title="Logout">@Icons.Render("log-out")<span>Logout</span></button>
        </form>
    </li>
}
else
{
    <li>
        <a class="btn-nav-ghost" asp-area="Identity" asp-page="/Account/Login">Login</a>
    </li>
}
</ul>
