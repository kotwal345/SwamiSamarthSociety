@model List<SwamiSamarthSociety.Data.Entities.Member>
@{
    ViewData["Title"] = "Members";
    var activeCount = Model.Count(m => m.Status == "Active");
    string? statusFilter = ViewBag.StatusFilter as string;
}

<div class="page-header">
    <div>
        <span class="page-eyebrow">सभासद यादी</span>
        <h1>Members</h1>
        @if (!string.IsNullOrEmpty(statusFilter))
        {
            <p class="page-subtitle">Showing <strong>@statusFilter</strong> members only. <a asp-action="Index">Clear filter</a></p>
        }
        else
        {
            <p class="page-subtitle">All registered members of the society.</p>
        }
    </div>
    @if (User.IsInRole(AppRoles.Chairman))
    {
        <a asp-action="Create" class="btn btn-primary">@Icons.Render("plus", "icon-sm")Add Member</a>
    }
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success mb-3">@TempData["Success"]</div>
}

<div class="stat-row">
    <div class="stat-tile accent-primary">
        <span class="stat-icon">@Icons.Render("users")</span>
        <span class="stat-body">
            <span class="stat-value">@Model.Count</span>
            <span class="stat-label">Total Members</span>
        </span>
    </div>
    <div class="stat-tile accent-success">
        <span class="stat-icon">@Icons.Render("user-check")</span>
        <span class="stat-body">
            <span class="stat-value">@activeCount</span>
            <span class="stat-label">Active</span>
        </span>
    </div>
    <div class="stat-tile accent-muted">
        <span class="stat-icon">@Icons.Render("user-x")</span>
        <span class="stat-body">
            <span class="stat-value">@(Model.Count - activeCount)</span>
            <span class="stat-label">Inactive / Left</span>
        </span>
    </div>
</div>

@if (Model.Count == 0)
{
    <div class="panel">
        <div class="empty-state">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /><path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75" /></svg>
            <h3>No members yet</h3>
            <p>Add your first society member to get started.</p>
            @if (User.IsInRole(AppRoles.Chairman))
            {
                <a asp-action="Create" class="btn btn-primary mt-2">@Icons.Render("plus", "icon-sm")Add Member</a>
            }
        </div>
    </div>
}
else
{
    <div class="table-panel">
        <div class="table-responsive">
        <table class="table">
            <thead>
                <tr>
                    <th>Member</th>
                    <th>Code</th>
                    <th>Mobile</th>
                    <th>Joining Date</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var m in Model)
                {
                    <tr>
                        <td>
                            <div class="cell-name">
                                <span class="member-avatar">@m.FullName.Substring(0, 1).ToUpper()</span>
                                <div>
                                    <div class="cell-name-text">@m.FullName</div>
                                    @if (!string.IsNullOrWhiteSpace(m.FullNameMarathi))
                                    {
                                        <div class="cell-name-sub">@m.FullNameMarathi</div>
                                    }
                                </div>
                            </div>
                        </td>
                        <td><code class="member-code">@m.MemberCode</code></td>
                        <td>@(string.IsNullOrWhiteSpace(m.MobileNumber) ? "—" : m.MobileNumber)</td>
                        <td>@m.JoiningDate.ToString("dd-MMM-yyyy")</td>
                        <td>
                            <span class="badge @(m.Status == "Active" ? "bg-success" : "bg-secondary")">@m.Status</span>
                        </td>
                        <td class="text-end">
                            <a asp-action="Details" asp-route-id="@m.MemberId" class="btn btn-sm btn-outline-primary">View</a>
                            @if (User.IsInRole(AppRoles.Chairman))
                            {
                                <a asp-action="Edit" asp-route-id="@m.MemberId" class="btn btn-sm btn-outline-secondary">Edit</a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        </div>
    </div>
}
