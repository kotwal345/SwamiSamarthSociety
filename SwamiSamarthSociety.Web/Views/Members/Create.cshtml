@model SwamiSamarthSociety.Data.Entities.Member
@{
    ViewData["Title"] = "Add Member";
}

<div class="page-header">
    <div>
        <span class="page-eyebrow">सभासद यादी</span>
        <h1>Add Member</h1>
        <p class="page-subtitle">Register a new member of the society.</p>
    </div>
</div>

<div class="panel" style="max-width: 760px;">
    <div class="form-panel-header">
        <h1>Member details</h1>
        <p>Fields marked with an asterisk are required.</p>
    </div>
    <form asp-action="Create" method="post" class="panel-pad">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

        <div class="form-grid">
            <div class="form-field form-field-full">
                <label class="form-label">Full Name *</label>
                <input asp-for="FullName" class="form-control" placeholder="e.g. Rushikesh Kotwal" required />
                <span asp-validation-for="FullName" class="text-danger"></span>
            </div>
            <div class="form-field form-field-full">
                <label class="form-label">Full Name (Marathi)</label>
                <input asp-for="FullNameMarathi" class="form-control" placeholder="मराठी नाव" />
            </div>
            <div class="form-field">
                <label class="form-label">Mobile Number</label>
                <input asp-for="MobileNumber" class="form-control" placeholder="10-digit mobile number" />
            </div>
            <div class="form-field">
                <label class="form-label">Joining Date *</label>
                <input asp-for="JoiningDate" type="date" class="form-control" required />
            </div>
            <div class="form-field form-field-full">
                <label class="form-label">Address</label>
                <textarea asp-for="Address" class="form-control" rows="2" placeholder="Residential address"></textarea>
            </div>
            <div class="form-field">
                <label class="form-label">Monthly Share Amount</label>
                <input asp-for="MonthlyShareAmount" class="form-control" value="500" />
                <span class="form-text-hint">Amount collected from this member every month.</span>
            </div>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-primary">Save Member</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
        </div>
    </form>
</div>
